  "units": [
    {
      "id": "kg-01",
      "title": "你好，小狐狸",
      "band": "3-4",
      "theme": "人与自我",
      "goal": "听懂问候，并用自己的名字回应。",
      "minutes": 7,
      "skills": [
        "听力感知",
        "口头模仿",
        "互动游戏"
      ],
      "knowledge": [
        "听到 Hello 时挥手回应，建立声音与动作的联系。",
        "用 My name is ... 介绍自己；允许只说自己的名字。",
        "用 Goodbye 结束活动，感受轮流交流。"
      ],
      "vocabulary": [
        {
          "en": "hello",
          "zh": "你好"
        },
        {
          "en": "goodbye",
          "zh": "再见"
        },
        {
          "en": "name",
          "zh": "名字"
        },
        {
          "en": "friend",
          "zh": "朋友"
        },
        {
          "en": "wave",
          "zh": "挥手"
        }
      ],
      "dialogue": [
        {
          "en": "Hello! My name is Fox.",
          "zh": "你好！我叫小狐狸。"
        },
        {
          "en": "Hello, Fox. My name is Mia.",
          "zh": "你好，小狐狸。我叫米娅。"
        },
        {
          "en": "Goodbye, Mia!",
          "zh": "再见，米娅！"
        }
      ],
      "reading": {
        "en": "Fox meets a new friend. They wave and say hello.",
        "zh": "小狐狸遇见了新朋友。他们挥手说你好。"
      },
      "writing": {
        "prompt": "家长与孩子拿玩偶互相问候，再挥手说再见。",
        "sample": "Hello! My name is ...",
        "checklist": [
          "愿意看向对方或挥手",
          "尝试发出 hello 的声音",
          "活动结束时回应 goodbye"
        ]
      },
      "questions": [
        {
          "id": "q1",
          "type": "choice",
          "prompt": "听一听：小狐狸在打招呼，哪一个是“你好”？",
          "options": [
            "Goodbye",
            "Hello",
            "Sleep"
          ],
          "answer": "Hello",
          "explanation": "Hello 用于见面打招呼。",
          "listen_text": "Hello!"
        },
        {
          "id": "q2",
          "type": "choice",
          "prompt": "听一听：小狐狸要离开了，它说了什么？",
          "options": [
            "Goodbye",
            "Hello",
            "Name"
          ],
          "answer": "Goodbye",
          "explanation": "Goodbye 用于告别，可以同时挥挥手。",
          "listen_text": "Goodbye!"
        },
        {
          "id": "q3",
          "type": "choice",
          "prompt": "听一听：My name is Fox. 小狐狸在告诉我们什么？",
          "options": [
            "它的颜色",
            "它的食物",
            "它的名字"
          ],
          "answer": "它的名字",
          "explanation": "My name is ... 表示“我的名字是……”。",
          "listen_text": "My name is Fox."
        },
        {
          "id": "q4",
          "type": "choice",
          "prompt": "要和朋友友好交流，我们可以做什么？",
          "options": [
            "一直打断朋友",
            "轮流打招呼",
            "背对朋友"
          ],
          "answer": "轮流打招呼",
          "explanation": "交流需要轮流，也可以用动作回应。",
          "listen_text": "Hello, friend!"
        }
      ]
    },
