# ===== 英语全能学习台 后端环境变量模板 =====
# 复制本文件为 .env 并填入真实值；宝塔 Python 项目「环境」里也可直接逐项填写。
# 注意：.env 含密钥，切勿提交到公开仓库。

# GitHub Container Registry 中的两个独立镜像
USER_IMAGE=ghcr.io/shirenliang12-source/english-study-user:latest
ADMIN_IMAGE=ghcr.io/shirenliang12-source/english-study-admin:latest

# 后台管理员密码（必填；留空时后台登录被禁用）
ADMIN_PASSWORD=

# 持久化数据目录；原生部署默认使用项目目录，Docker Compose 会覆盖为 /data
APP_DATA_DIR=./data
# 可选：单独指定数据库与 TTS 缓存路径；留空时使用 APP_DATA_DIR
APP_DB_PATH=
TTS_CACHE_DIR=

# 可选：独立前端域名白名单，多个地址用英文逗号分隔；同源部署请留空
CORS_ORIGINS=

# 业务日期使用的 UTC 时差（中国大陆为 8）
APP_UTC_OFFSET_HOURS=8

# 微信小程序登录（小程序后台「开发设置 → 开发者ID」获取）
WX_APP_ID=
WX_APP_SECRET=

# 讯飞语音评测密钥（控制台「语音评测 ISE」服务）
IFly_APP_ID=
IFly_API_KEY=
IFly_API_SECRET=

# AI 口语陪练（OpenAI 兼容接口，默认 DeepSeek；留空则 /chat 不可用）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 邮件服务（阿里云邮箱 SMTP，注册后给用户的个人邮箱发通知/激活邮件）=====
# 发件邮箱（阿里云企业邮：如 noreply@englearner.cn；个人邮：you@aliyun.com）
MAIL_USERNAME=
# 邮箱「客户端授权码」（不是网页登录密码！需在邮箱设置开启 SMTP/IMAP 后获取）
MAIL_PASSWORD=
# 阿里云企业邮箱 SMTP 服务器（默认 smtp.qiye.aliyun.com，端口 465 SSL）
# 若用阿里云个人邮，改为 smtp.aliyun.com
MAIL_SMTP_HOST=smtp.qiye.aliyun.com
MAIL_SMTP_PORT=465
# 邮件发件人显示名
MAIL_FROM_NAME=英语学习台
# 站点对外地址（用于拼接邮箱激活链接，必须填你的正式域名，如 https://englearner.cn）
SITE_BASE_URL=https://englearner.cn
# HTTPS 自动证书使用的纯域名（不带 https://），供 Docker Caddy 配置读取
SITE_DOMAIN=englearner.cn
# 管理后台独立域名（建议不要与用户站共用入口）
ADMIN_DOMAIN=admin.englearner.cn
# Let's Encrypt 到期提醒邮箱（宿主机 Nginx + Certbot 部署必填）
LETSENCRYPT_EMAIL=admin@englearner.cn
# 激活链接签名密钥（留空则复用 ADMIN_PASSWORD；生产环境建议单独设置强随机值）
MAIL_SECRET=

