.profile-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2563eb;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 120rpx;
  margin: 0 auto;
}

.nick {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-top: 16rpx;
}

.level {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-box {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2563eb;
}

.lab {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.menu {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  color: #374151;
}

.group-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #c4c4c4;
  font-size: 36rpx;
}

.bind-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}

.bind-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.bind-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.bind-input {
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.bind-msg {
  color: #ef4444;
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 8rpx;
}
