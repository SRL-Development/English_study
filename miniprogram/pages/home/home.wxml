<view class="container">
  <view class="topbar">
    <view class="stat">连续 {{streak}} 天</view>
    <view class="stat">今日 {{todayCount}} 词</view>
    <view class="stat scene">{{scene}}</view>
  </view>

  <block wx:if="{{status === 'loading'}}">
    <view class="placeholder">加载中...</view>
  </block>

  <block wx:elif="{{status === 'empty'}}">
    <view class="placeholder">该场景暂无词库，去“我的”切换场景</view>
  </block>

  <block wx:else>
    <view class="progress">第 {{index + 1}} / {{total}} 词</view>

    <view class="card word-card">
      <view class="word">{{word.word}}</view>
      <view class="phonetic">{{word.phonetic}}</view>
      <view class="meaning">{{word.meaning}}</view>
      <view class="example" wx:if="{{word.example}}">{{word.example}}</view>
    </view>

    <view class="actions">
      <button class="act" bindtap="onPlay">听单词</button>
      <button class="act" bindtap="onPlaySentence">听例句</button>
    </view>

    <button class="record-btn {{recording ? 'recording' : ''}}" bindtap="onRecord">
      {{recording ? '停止并评测' : '跟读纠音'}}
    </button>

    <block wx:if="{{score !== null}}">
      <view class="card score-card">
        <view class="score-num">{{score}}</view>
        <view class="score-label">综合评分</view>
        <view class="word-scores" wx:if="{{wordScores.length}}">
          <view class="ws-item" wx:for="{{wordScores}}" wx:key="word">
            <text class="ws-word">{{item.word}}</text>
            <text class="ws-score">{{item.score}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="mark-row">
      <button class="mark unknown" bindtap="onUnknown">不认识</button>
      <button class="mark know" bindtap="onKnow">认识</button>
    </view>
  </block>
</view>
