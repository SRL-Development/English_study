.topbar {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.stat {
  font-size: 26rpx;
  color: #6b7280;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.stat.scene {
  color: #2563eb;
}

.progress {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
  text-align: center;
}

.word-card {
  text-align: center;
  padding: 56rpx 32rpx;
}

.word {
  font-size: 64rpx;
  font-weight: 700;
  color: #111827;
}

.phonetic {
  font-size: 30rpx;
  color: #6b7280;
  margin-top: 12rpx;
}

.meaning {
  font-size: 36rpx;
  color: #2563eb;
  margin-top: 20rpx;
}

.example {
  font-size: 28rpx;
  color: #4b5563;
  margin-top: 20rpx;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.act {
  flex: 1;
  background: #eef2ff;
  color: #2563eb;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.act::after {
  border: none;
}

.record-btn {
  width: 100%;
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.record-btn::after {
  border: none;
}

.record-btn.recording {
  background: #ef4444;
}

.score-card {
  text-align: center;
}

.score-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #16a34a;
}

.score-label {
  font-size: 26rpx;
  color: #6b7280;
}

.word-scores {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.ws-item {
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
}

.ws-word {
  color: #374151;
  margin-right: 8rpx;
}

.ws-score {
  color: #16a34a;
  font-weight: 600;
}

.mark-row {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.mark {
  flex: 1;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}

.mark.know {
  background: #16a34a;
  color: #ffffff;
}

.mark.unknown {
  background: #f3f4f6;
  color: #374151;
}

.mark::after {
  border: none;
}
