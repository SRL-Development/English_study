<view class="container">
  <view class="header">
    <view class="title">英语全能学习台</view>
    <view class="subtitle">听说读写 · 语法 · 纠音 · AI 陪练</view>
  </view>

  <block wx:if="{{step === 'login'}}">
    <view class="card">
      <view class="tip">使用微信一键登录，开始你的英语学习</view>
      <button class="primary-btn" bindtap="onWxLogin">微信一键登录</button>
    </view>
  </block>

  <block wx:elif="{{step === 'questionnaire'}}">
    <view class="card">
      <view class="tip">先了解一下你的情况，为你推荐内容</view>
      <view class="form-row">
        <text class="label">当前英语基础</text>
        <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="onLevelChange">
          <view class="picker">{{levels[levelIndex]}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="label">想重点提升的场景</text>
        <picker mode="selector" range="{{scenes}}" value="{{sceneIndex}}" bindchange="onSceneChange">
          <view class="picker">{{scenes[sceneIndex]}}</view>
        </picker>
      </view>
      <button class="primary-btn" bindtap="onSubmitQuestionnaire">开始学习</button>
    </view>
  </block>
</view>
