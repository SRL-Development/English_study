# systemd 兜底方案（仅当不用宝塔「Python 项目」管理器时启用）
# 用法：
#   1) 把本文件放到 /etc/systemd/system/flask-app.service
#   2) 修改 WorkingDirectory / EnvironmentFile / ExecStart 路径为你实际上传目录
#   3) systemctl daemon-reload && systemctl enable --now flask-app
#
# 说明：gunicorn 只监听 127.0.0.1:5000，由宝塔「网站 → 反向代理」对外暴露，
#       不要直接把 5000 暴露到公网。

[Unit]
Description=English Learning Flask Backend
After=network.target

[Service]
# 宝塔默认站点用户通常为 www；如实际不同请同步调整目录权限与此处用户
User=www
Group=www
WorkingDirectory=/www/wwwroot/english
EnvironmentFile=/www/wwwroot/english/.env
ExecStart=/www/wwwroot/english/venv/bin/gunicorn -w 2 --threads 4 --timeout 90 -b 127.0.0.1:5000 server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
